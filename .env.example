# Copy this file to ".env" in the project root and paste your real key.
# Never commit the real .env file.

# Which AI provider to use (today: openai). Future: anthropic, etc.
AI_PROVIDER=openai

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-real-key-goes-here

# Optional model override (default in code: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# When true, responses.py asks the AI to warm up factual drafts.
# When false (or if the API call fails), clear template wording is used.
AI_WARM_REWRITE=true
